# Copy this file to .env and adjust if needed:
#   cp .env.example .env
#
# Every value has a working default, so .env is optional.
# No secrets belong here: Ollama runs locally and needs no credentials.

# Base URL of the local Ollama HTTP API.
OLLAMA_BASE_URL=http://localhost:11434

# Model pre-selected in the sidebar (for example qwen2.5:7b or llama3.2).
# Leave empty to use the first installed model.
OLLAMA_MODEL=

# Seconds to wait for a generation response. Raise it for larger models.
OLLAMA_TIMEOUT=120
